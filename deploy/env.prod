# Beaty production — betwelc.ru (VPS /root/beaty/.env.prod)
# Секреты: подставьте вручную из .secrets.env и TELEGRAM_SECRET
# или: TELEGRAM_SECRET=... PUBLIC_HTTPS_URL=https://betwelc.ru bash scripts/write-env-from-ci.sh
#
# После правки на сервере:
#   cp deploy/env.prod .env.prod   # или scp deploy/env.prod -> /root/beaty/.env.prod
#   chmod 600 .env.prod
#   ./scripts/redeploy.sh nobuild

COMPOSE_PROJECT_NAME=beaty
ENVIRONMENT=production
WEB_PORT=4040
WEB_UI_PORT=3030
WEB_DEFAULT_TENANT=

# --- секреты (НЕ коммитить реальные значения в git; на сервере уже есть .secrets.env) ---
POSTGRES_PASSWORD=CHANGEME_POSTGRES
TOKEN_ENCRYPTION_KEY=CHANGEME_TOKEN_ENC
JWT_SECRET=CHANGEME_JWT
PLATFORM_BOT_TOKEN=CHANGEME_PLATFORM_BOT
PLATFORM_MAX_BOT_TOKEN=
MAX_PLATFORM_WEBHOOK_SECRET=
MAX_API_BASE_URL=https://platform-api2.max.ru

DATABASE_URL=postgresql+asyncpg://beaty:CHANGEME_POSTGRES@postgres:5432/beaty
REDIS_URL=redis://redis:6379/0

TELEGRAM_PROXY=
SENTRY_DSN=

# Публичный URL (после certbot на betwelc.ru)
WEBHOOK_BASE_URL=https://betwelc.ru
PUBLIC_WEB_URL=https://betwelc.ru
TENANT_UI_MODE=miniapp
WEB_COOKIE_SECURE=true

WEB_DEV_LOGIN=false
# Optional: redirect https://betwelc.ru/ to one salon (no public tenant list on /)
# WEB_DEFAULT_TENANT=
ENABLE_PUBLIC_API=false